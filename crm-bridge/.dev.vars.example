# Copy to .dev.vars for local `wrangler dev` (that file is gitignored).
# In production this is set with `wrangler secret put CRM_API_KEY`, not committed.

# A Threadwise API key scoped to exactly `records:write` — mint one via
# Settings -> Identity & access -> API keys on the live instance, or
# POST /api/api-keys while signed in. See README.md "Getting a Threadwise
# API key". Format: tw_ + 40 characters.
CRM_API_KEY=tw_replace-with-a-real-scoped-key
